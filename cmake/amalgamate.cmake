# amalgamate.cmake: builds the single-header distribution from the sources
if(NOT DEFINED LIBPXL_OUT OR NOT DEFINED LIBPXL_FILES)
    message(FATAL_ERROR "amalgamate.cmake: LIBPXL_OUT and LIBPXL_FILES are required")
endif()

file(WRITE "${LIBPXL_OUT}" "/* libpxl single-header build; generated by cmake/amalgamate.cmake */\n")
file(APPEND "${LIBPXL_OUT}" "#ifndef LIBPXL_SINGLE_H\n#define LIBPXL_SINGLE_H\n")

foreach(file IN LISTS LIBPXL_FILES)
    get_filename_component(name "${file}" NAME)
    file(READ "${file}" contents)
    # drop local includes; the amalgamation provides everything in one file
    string(REGEX REPLACE "#[ \t]*include[ \t]*\"[^\"]*\"[ \t]*\r?\n" "" contents "${contents}")
    file(APPEND "${LIBPXL_OUT}" "\n/* ${name} */\n")
    file(APPEND "${LIBPXL_OUT}" "${contents}\n")
endforeach()

file(APPEND "${LIBPXL_OUT}" "\n#endif /* LIBPXL_SINGLE_H */\n")
